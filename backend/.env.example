# ================================================================
# Smart Attendance - Backend Configuration Template (Supabase / Render)
# ================================================================

# Supabase PostgreSQL Connection URI
# Option A - Connection Pooler (Recommended for IPv4 compatibility on local Windows & Render free tier):
#   Session Mode (port 5432):
#   DATABASE_URL=postgresql://postgres.gdvlwaiunaxtdnvzaxnv:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#   Transaction Mode (port 6543):
#   DATABASE_URL=postgresql://postgres.gdvlwaiunaxtdnvzaxnv:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
#
# Option B - Direct Connection (Requires IPv6 network support):
#   DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.gdvlwaiunaxtdnvzaxnv.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.gdvlwaiunaxtdnvzaxnv:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Authentication Secret
SECRET_KEY=smart-attendance-institutional-production-master-secret-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Institutional Thresholds
BLE_SIGNAL_RANGE_DEFAULT=15.0
BLE_RSSI_THRESHOLD_DEFAULT=-75.0
FACE_CONFIDENCE_THRESHOLD_DEFAULT=85.0

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
ALLOW_GOOGLE_AUTOPROVISION=true
