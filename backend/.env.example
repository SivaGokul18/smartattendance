# Smart Attendance MySQL 8.x Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=smart_attendance

# Authentication Secret
SECRET_KEY=smart-attendance-institutional-production-master-secret-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional Redis Pub/Sub for WebSockets across multiple ASGI instances
# REDIS_URL=redis://localhost:6379/0

# Institutional Thresholds
BLE_SIGNAL_RANGE_DEFAULT=15.0
BLE_RSSI_THRESHOLD_DEFAULT=-75.0
FACE_CONFIDENCE_THRESHOLD_DEFAULT=85.0

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
